# Docker Compose 对外端口。旧系统继续使用 3002，新系统使用 3003。
APP_PORT=3003

# 容器内应用进程使用宿主机账号的 UID/GID 写入 ./data。
# 在 miniPC 上分别运行 `id -u` 和 `id -g` 后填写。
APP_UID=1000
APP_GID=1000

TZ=Asia/Shanghai
ADMIN_USERNAME=admin

# 必须替换为独立的高强度初始密码；不要提交真实 .env。
ADMIN_PASSWORD=replace-with-a-long-random-password

# 当前公网入口是 HTTP，必须为 false。切换到 HTTPS 反向代理后再改为 true。
COOKIE_SECURE=false

# 月备份保留天数，默认约 13 个月。
BACKUP_RETENTION_DAYS=400
